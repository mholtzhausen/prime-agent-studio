{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prime Agent Studio Nix",
  "version": "../package.json",
  "identifier": "com.primeagent.studio.nix",
  "build": {
    "frontendDist": "../desktop",
    "beforeBuildCommand": "node scripts/build-desktop-resources.mjs",
    "beforeDevCommand": "node scripts/build-desktop-resources.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'",
      "capabilities": [
        {
          "identifier": "launcher",
          "windows": [
            "main",
            "desktop-settings"
          ],
          "permissions": [
            "core:default",
            "allow-desktop-state",
            "allow-desktop-components",
            "allow-desktop-components-cancel",
            "allow-desktop-components-open",
            "allow-desktop-autostart",
            "allow-desktop-choose-legacy",
            "allow-desktop-logs",
            "allow-desktop-start",
            "allow-desktop-update-status",
            "allow-desktop-server-restart",
            "allow-desktop-update-check",
            "allow-desktop-update-install"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "resources": {
      "../.desktop-build/": "backend/"
    },
    "publisher": "zerr0o",
    "copyright": "Copyright (c) zerr0o",
    "shortDescription": "Local workspace for Prime Agent",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mholtzhausen/prime-agent-studio/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCN0ZEQUJBNTI2ODQ4RUYKUldUdlNHaFN1dHAvYStBekJoN2RsUW1qWVBtNHljVVgvS000ckkwd2ZMU3JUQUJKdWJrV21lYysK\n"
    }
  }
}
